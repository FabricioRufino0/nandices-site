# Domínio confirmado; opcional no desenvolvimento local.
SITE_URL=

# Somente no servidor. Nunca prefixar estas variáveis com VITE_.
# Na Cloudflare, guardar GOOGLE_MAPS_API_KEY e DELIVERY_ORIGIN como secrets.
GOOGLE_MAPS_API_KEY=
DELIVERY_ORIGIN=
VEHICLE_KM_PER_LITER=
FUEL_PRICE=
# one-way = ida; round-trip = rotas reais de ida + volta. Sem padrão.
DELIVERY_TRIP_MODE=
