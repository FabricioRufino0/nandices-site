{
  "name": "nandices-confeitaria",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-10",
  "keep_vars": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/encomenda", "/encomenda/"]
  },

  "vars": {
    "DELIVERY_TRIP_MODE": "round-trip"
  },
  "ratelimits": [
    { "name": "DELIVERY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
