{
  "name": "nandices-confeitaria",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-10",
  "keep_vars": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "DELIVERY_TRIP_MODE": "round-trip"
  },

  "secrets": {
    "required": [
      "OPENROUTESERVICE_API_KEY",
      "DELIVERY_ORIGIN"
    ]
  }
}
